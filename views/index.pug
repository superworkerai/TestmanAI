extends layout

block content
  .text-center.py-12
    h1.text-5xl.font-bold.text-gray-900.mb-4 Welcome to TestmanAI
    p.text-xl.text-gray-600.mb-8 AI-Powered End-to-End Testing with Natural Language

  .grid.grid-cols-1.md:grid-cols-3.gap-8.mt-12
    .card.text-center
      .text-primary-600.mb-4
        svg.w-16.h-16.mx-auto(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
      h3.text-xl.font-semibold.mb-2 Write Tests in Plain English
      p.text-gray-600 Create test suites using natural language instructions. No coding required!
      a.btn-primary.mt-4.inline-block(href="/test-suites/new") Create Test Suite

    .card.text-center
      .text-primary-600.mb-4
        svg.w-16.h-16.mx-auto(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
      h3.text-xl.font-semibold.mb-2 AI-Powered Execution
      p.text-gray-600 Our AI converts your instructions to Playwright code and runs them automatically.
      a.btn-primary.mt-4.inline-block(href="/test-suites") View Test Suites

    .card.text-center
      .text-primary-600.mb-4
        svg.w-16.h-16.mx-auto(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z")
      h3.text-xl.font-semibold.mb-2 Detailed Results
      p.text-gray-600 View comprehensive test results with screenshots and videos of test execution.
      a.btn-primary.mt-4.inline-block(href="/test-runs") View Test Runs

  .mt-16.card.bg-primary-50.border-primary-200
    h2.text-2xl.font-semibold.mb-4.text-center How It Works
    .grid.grid-cols-1.md:grid-cols-4.gap-6.mt-8
      .text-center
        .bg-primary-600.text-white.rounded-full.w-12.h-12.flex.items-center.justify-center.mx-auto.mb-3.text-xl.font-bold 1
        h4.font-semibold.mb-2 Write Instructions
        p.text-sm.text-gray-600 Describe your test steps in plain English

      .text-center
        .bg-primary-600.text-white.rounded-full.w-12.h-12.flex.items-center.justify-center.mx-auto.mb-3.text-xl.font-bold 2
        h4.font-semibold.mb-2 AI Conversion
        p.text-sm.text-gray-600 OpenAI converts to Playwright code

      .text-center
        .bg-primary-600.text-white.rounded-full.w-12.h-12.flex.items-center.justify-center.mx-auto.mb-3.text-xl.font-bold 3
        h4.font-semibold.mb-2 Execute Tests
        p.text-sm.text-gray-600 Tests run automatically with Chromium

      .text-center
        .bg-primary-600.text-white.rounded-full.w-12.h-12.flex.items-center.justify-center.mx-auto.mb-3.text-xl.font-bold 4
        h4.font-semibold.mb-2 View Results
        p.text-sm.text-gray-600 Get detailed reports with media
