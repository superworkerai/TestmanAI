doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'TestmanAI'
    link(rel="stylesheet" href="/css/output.css")
    script(defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js")
  body.bg-gray-50.min-h-screen
    nav.bg-white.shadow-sm
      .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8
        .flex.justify-between.h-16
          .flex.items-center
            a.text-2xl.font-bold.text-primary-600(href="/") TestmanAI
          .flex.items-center.space-x-8
            a.text-gray-700.hover:text-primary-600.transition(href="/test-suites") Test Suites
            a.text-gray-700.hover:text-primary-600.transition(href="/test-runs") Test Runs
            a.text-gray-700.hover:text-primary-600.transition(href="/variables") Variables

    main.max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
      block content

    footer.mt-12.bg-white.border-t
      .max-w-7xl.mx-auto.px-4.sm:px-6.lg:px-8.py-6
        .text-center.text-gray-500.text-sm
          p &copy; #{new Date().getFullYear()} TestmanAI - AI-Powered End-to-End Testing
