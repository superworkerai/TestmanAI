extends ../layout

block content
  div(x-data="testRunsPage()")
    .flex.justify-between.items-center.mb-8
      h1.text-3xl.font-bold.text-gray-900 Test Runs
      .flex.space-x-3
        select.input-field.w-48(x-model="statusFilter" @change="loadTestRuns")
          option(value="") All Statuses
          option(value="running") Running
          option(value="completed") Completed
          option(value="failed") Failed
          option(value="pending") Pending

    div(x-show="loading")
      .text-center.py-12
        .spinner.mx-auto
        p.mt-4.text-gray-600 Loading test runs...

    div(x-show="!loading && testRuns.length === 0" x-cloak)
      .card.text-center.py-12
        svg.w-24.h-24.mx-auto.text-gray-400.mb-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4")
        h3.text-xl.font-semibold.mb-2 No Test Runs Yet
        p.text-gray-600.mb-4 Run a test suite to see results here
        a.btn-primary(href="/test-suites") Go to Test Suites

    div(x-show="!loading && testRuns.length > 0" x-cloak)
      .card.overflow-x-auto
        table.min-w-full.divide-y.divide-gray-200
          thead.bg-gray-50
            tr
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Test Suite
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Status
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Result
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Steps
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Duration
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Started
              th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Actions

          tbody.bg-white.divide-y.divide-gray-200
            template(x-for="run in testRuns" :key="run._id")
              tr(class="hover:bg-gray-50 cursor-pointer")(@click=`window.location.href='/test-runs/' + run._id`)
                td.px-4.py-4
                  .font-medium(x-text="run.testSuiteName")
                td.px-4.py-4.whitespace-nowrap
                  span.badge-running(x-show="run.status === 'running'") Running
                  span.badge-success(x-show="run.status === 'completed'") Completed
                  span.badge-error(x-show="run.status === 'failed'") Failed
                  span.badge-pending(x-show="run.status === 'pending'") Pending
                  span.badge-pending(x-show="run.status === 'cancelled'") Cancelled
                td.px-4.py-4.whitespace-nowrap
                  span.badge-success(x-show="run.overallResult === 'passed'") Passed
                  span.badge-error(x-show="run.overallResult === 'failed'") Failed
                  span.badge-pending(x-show="run.overallResult === 'partial'") Partial
                  span(x-show="!run.overallResult") -
                td.px-4.py-4.whitespace-nowrap.text-sm.text-gray-600
                  div
                    span.text-green-600(x-text="run.passedSteps || 0") 0
                    span  /
                    span(x-text="run.totalSteps || 0")
                  div.text-xs.text-gray-500
                    span.text-red-600(x-show="run.failedSteps > 0" x-text="`${run.failedSteps} failed`")
                td.px-4.py-4.whitespace-nowrap.text-sm.text-gray-600
                  span(x-show="run.duration" x-text="`${(run.duration / 1000).toFixed(1)}s`")
                  span(x-show="!run.duration") -
                td.px-4.py-4.whitespace-nowrap.text-sm.text-gray-600
                  span(x-text="run.startedAt ? new Date(run.startedAt).toLocaleString() : 'Not started'")
                td.px-4.py-4.whitespace-nowrap.text-sm
                  a(class="text-primary-600 hover:underline")(@click.stop :href="`/test-runs/${run._id}`") View Results

  script.
    function testRunsPage() {
      return {
        testRuns: [],
        loading: true,
        statusFilter: '',

        async init() {
          await this.loadTestRuns();
        },

        async loadTestRuns() {
          try {
            this.loading = true;
            const params = new URLSearchParams();
            if (this.statusFilter) {
              params.append('status', this.statusFilter);
            }

            const response = await fetch(`/api/test-runs?${params.toString()}`);
            const data = await response.json();

            if (data.success) {
              this.testRuns = data.data;
            } else {
              alert('Failed to load test runs');
            }
          } catch (err) {
            alert('Error loading test runs: ' + err.message);
          } finally {
            this.loading = false;
          }
        }
      }
    }
