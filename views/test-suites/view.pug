extends ../layout

block content
  div(x-data=`viewTestSuitePage('${testSuiteId}')`)
    div(x-show="loading")
      .text-center.py-12
        .spinner.mx-auto
        p.mt-4.text-gray-600 Loading test suite...

    div(x-show="!loading" x-cloak)
      .flex.justify-between.items-start.mb-8
        div
          h1.text-3xl.font-bold.text-gray-900.mb-2(x-text="suite.name")
          p.text-gray-600(x-text="suite.description || 'No description'")

        .flex.space-x-3
          button.btn-success(@click="runTest") Run Test
          a.btn-secondary(:href="`/test-suites/${testSuiteId}/edit`") Edit
          a.btn-secondary(href="/test-suites") Back to List

      .grid.grid-cols-1.lg:grid-cols-3.gap-6
        .lg:col-span-2
          .card.mb-6
            h2.text-xl.font-semibold.mb-4 Test Steps
            .space-y-4
              template(x-for="(step, index) in suite.steps" :key="index")
                .test-step
                  .flex.items-start
                    span.bg-primary-600.text-white.rounded-full.w-8.h-8.flex.items-center.justify-center.text-sm.font-bold.mr-3.flex-shrink-0(x-text="index + 1")
                    div.flex-1
                      p.font-medium.mb-1(x-text="step.instruction")
                      p.text-sm.text-gray-600(x-show="step.description" x-text="step.description")

        .lg:col-span-1
          .card.mb-6
            h2.text-xl.font-semibold.mb-4 Variables
            div(x-show="suite.variables && suite.variables.length > 0")
              .space-y-2
                template(x-for="variable in suite.variables" :key="variable._id")
                  .flex.items-center.justify-between.p-2.bg-gray-50.rounded
                    .flex-1
                      .font-medium.text-sm(x-text="variable.name")
                      .text-xs.text-gray-600(x-text="variable.description || 'No description'")
                    .badge-success(x-show="variable.isSensitive") Encrypted

            div(x-show="!suite.variables || suite.variables.length === 0")
              p.text-gray-500.text-sm No variables used

          .card.mb-6
            h2.text-xl.font-semibold.mb-4 Metadata
            .space-y-2.text-sm
              .flex.justify-between
                span.text-gray-600 Total Steps:
                span.font-medium(x-text="suite.steps.length")
              .flex.justify-between
                span.text-gray-600 Created:
                span.font-medium(x-text="new Date(suite.createdAt).toLocaleDateString()")
              .flex.justify-between
                span.text-gray-600 Updated:
                span.font-medium(x-text="new Date(suite.updatedAt).toLocaleDateString()")

      .card
        h2.text-xl.font-semibold.mb-4 Recent Test Runs
        div(x-show="loadingRuns")
          .text-center.py-6
            .spinner.mx-auto
            p.mt-2.text-gray-600 Loading test runs...

        div(x-show="!loadingRuns && testRuns.length === 0" x-cloak)
          .text-center.py-6.text-gray-500
            p No test runs yet. Click "Run Test" to start your first test.

        div(x-show="!loadingRuns && testRuns.length > 0" x-cloak)
          .overflow-x-auto
            table.min-w-full.divide-y.divide-gray-200
              thead.bg-gray-50
                tr
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Status
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Result
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Steps
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Duration
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Started
                  th.px-4.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase Actions

              tbody.bg-white.divide-y.divide-gray-200
                template(x-for="run in testRuns" :key="run._id")
                  tr.hover:bg-gray-50
                    td.px-4.py-3.whitespace-nowrap
                      span.badge-running(x-show="run.status === 'running'") Running
                      span.badge-success(x-show="run.status === 'completed'") Completed
                      span.badge-error(x-show="run.status === 'failed'") Failed
                      span.badge-pending(x-show="run.status === 'pending'") Pending
                    td.px-4.py-3.whitespace-nowrap
                      span.badge-success(x-show="run.overallResult === 'passed'") Passed
                      span.badge-error(x-show="run.overallResult === 'failed'") Failed
                      span.badge-pending(x-show="run.overallResult === 'partial'") Partial
                      span(x-show="!run.overallResult") -
                    td.px-4.py-3.whitespace-nowrap.text-sm.text-gray-600
                      span(x-text="`${run.passedSteps || 0}/${run.totalSteps || 0}`")
                    td.px-4.py-3.whitespace-nowrap.text-sm.text-gray-600
                      span(x-show="run.duration" x-text="`${(run.duration / 1000).toFixed(1)}s`")
                      span(x-show="!run.duration") -
                    td.px-4.py-3.whitespace-nowrap.text-sm.text-gray-600
                      span(x-text="run.startedAt ? new Date(run.startedAt).toLocaleString() : '-'")
                    td.px-4.py-3.whitespace-nowrap.text-sm
                      a.text-primary-600.hover:underline(:href="`/test-runs/${run._id}`") View Results

  script.
    function viewTestSuitePage(testSuiteId) {
      return {
        testSuiteId,
        suite: {},
        testRuns: [],
        loading: true,
        loadingRuns: true,

        async init() {
          await this.loadSuite();
          await this.loadTestRuns();
        },

        async loadSuite() {
          try {
            this.loading = true;
            const response = await fetch(`/api/test-suites/${this.testSuiteId}`);
            const data = await response.json();

            if (data.success) {
              this.suite = data.data;
            } else {
              alert('Failed to load test suite');
            }
          } catch (err) {
            alert('Error loading test suite: ' + err.message);
          } finally {
            this.loading = false;
          }
        },

        async loadTestRuns() {
          try {
            this.loadingRuns = true;
            const response = await fetch(`/api/test-suites/${this.testSuiteId}/runs`);
            const data = await response.json();

            if (data.success) {
              this.testRuns = data.data;
            }
          } catch (err) {
            console.error('Error loading test runs:', err);
          } finally {
            this.loadingRuns = false;
          }
        },

        async runTest() {
          try {
            const response = await fetch('/api/test-runs', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ testSuiteId: this.testSuiteId })
            });
            const data = await response.json();

            if (data.success) {
              window.location.href = `/test-runs/${data.data._id}`;
            } else {
              alert('Failed to start test run: ' + data.error);
            }
          } catch (err) {
            alert('Error starting test run: ' + err.message);
          }
        }
      }
    }
