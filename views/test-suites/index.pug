extends ../layout

block content
  div(x-data="testSuitesPage()")
    .flex.justify-between.items-center.mb-8
      h1.text-3xl.font-bold.text-gray-900 Test Suites
      a.btn-primary(href="/test-suites/new") + New Test Suite

    //- Loading state
    div(x-show="loading")
      .text-center.py-12
        .spinner.mx-auto
        p.mt-4.text-gray-600 Loading test suites...

    //- Error state
    div(x-show="error" x-cloak)
      .bg-red-50.border.border-red-200.rounded-lg.p-4.mb-4
        p.text-red-800(x-text="error")

    //- Empty state
    div(x-show="!loading && testSuites.length === 0" x-cloak)
      .card.text-center.py-12
        svg.w-24.h-24.mx-auto.text-gray-400.mb-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z")
        h3.text-xl.font-semibold.mb-2 No Test Suites Yet
        p.text-gray-600.mb-4 Get started by creating your first test suite
        a.btn-primary(href="/test-suites/new") Create Your First Test Suite

    //- Test suites grid
    div(x-show="!loading && testSuites.length > 0" x-cloak)
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6
        template(x-for="suite in testSuites" :key="suite._id")
          .card.hover:shadow-lg.transition.cursor-pointer(@click=`window.location.href='/test-suites/' + suite._id`)
            .flex.justify-between.items-start.mb-4
              h3.text-xl.font-semibold(x-text="suite.name")
              .flex.space-x-2
                button.text-blue-600.hover:text-blue-800(@click.stop=`window.location.href='/test-suites/' + suite._id + '/edit'`)
                  svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z")
                button.text-red-600.hover:text-red-800(@click.stop="deleteSuite(suite._id)")
                  svg.w-5.h-5(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16")

            p.text-gray-600.mb-4(x-text="suite.description || 'No description'")

            .flex.items-center.justify-between.text-sm.text-gray-500
              .flex.items-center
                svg.w-4.h-4.mr-1(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2")
                span(x-text="suite.steps.length + ' steps'")

              button.btn-success.text-sm.py-1.px-3(@click.stop="runTest(suite._id)") Run Test

  script.
    function testSuitesPage() {
      return {
        testSuites: [],
        loading: true,
        error: null,

        async init() {
          await this.loadTestSuites();
        },

        async loadTestSuites() {
          try {
            this.loading = true;
            this.error = null;
            const response = await fetch('/api/test-suites');
            const data = await response.json();

            if (data.success) {
              this.testSuites = data.data;
            } else {
              this.error = 'Failed to load test suites';
            }
          } catch (err) {
            this.error = 'Error loading test suites: ' + err.message;
          } finally {
            this.loading = false;
          }
        },

        async deleteSuite(id) {
          if (!confirm('Are you sure you want to delete this test suite?')) {
            return;
          }

          try {
            const response = await fetch(`/api/test-suites/${id}`, {
              method: 'DELETE'
            });
            const data = await response.json();

            if (data.success) {
              await this.loadTestSuites();
            } else {
              alert('Failed to delete test suite');
            }
          } catch (err) {
            alert('Error deleting test suite: ' + err.message);
          }
        },

        async runTest(id) {
          try {
            const response = await fetch('/api/test-runs', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ testSuiteId: id })
            });
            const data = await response.json();

            if (data.success) {
              window.location.href = `/test-runs/${data.data._id}`;
            } else {
              alert('Failed to start test run: ' + data.error);
            }
          } catch (err) {
            alert('Error starting test run: ' + err.message);
          }
        }
      }
    }
